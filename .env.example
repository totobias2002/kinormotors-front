# Copiar a .env (NO se versiona). En Vercel se cargan en Settings > Environment Variables.

# URL de la API (kinormotors-back). Sin esta variable el sitio usa los modelos de src/data/modelos.json
VITE_API_URL=http://localhost:8080/api

# Numero de WhatsApp en formato internacional, solo digitos (ej: 5491112345678)
# TODO: reemplazar por el numero real que pase Javier
VITE_WHATSAPP_NUMERO=5491100000000

# Video de la seccion "Dominá tu movimiento" (opcional; sin esto se muestra un fondo)
VITE_VIDEO_HOME_URL=
